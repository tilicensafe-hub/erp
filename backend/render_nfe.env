# Configuracao NF-e para colar no Render > Environment
# Nao envie este arquivo para GitHub depois de preencher certificado e senha.

NFE_ONLINE_ENABLED=true

# Use false primeiro para teste em homologacao. Depois de validar, troque para true.
NFE_PRODUCTION=false

# Ative somente quando o motor SEFAZ online estiver implementado no backend.
NFE_SEFAZ_ENGINE_ONLINE=true

# Certificado A1 PFX em Base64 e senha do certificado.
NFE_CERTIFICATE_PFX_BASE64=COLE_AQUI_O_BASE64_DO_CERTIFICADO_PFX
NFE_CERTIFICATE_PASSWORD=SENHA_DO_CERTIFICADO

# Dados do emitente
NFE_ISSUER_CNPJ=45284524000190
NFE_ISSUER_IE=372268128119
NFE_ISSUER_LEGAL_NAME=HUGO R GLAUZER LTDA
NFE_ISSUER_TRADE_NAME=GLAUZER CONSTRUTORA
NFE_ISSUER_ADDRESS=ESTRADA MUNICIPAL DO BRO CAPUTERA SITIO KI XODO, SN, AREA RURAL DE ITAPEVA, ITAPEVA, SP, CEP 18419899
NFE_ISSUER_PHONE=15998526797
NFE_ISSUER_EMAIL=ti.licensafe@gmail.com
NFE_ISSUER_UF=SP

# Codigo IBGE do municipio emissor
NFE_CITY_CODE=3522406

# 1 = Simples Nacional, 2 = Simples excesso sublimite, 3 = Regime Normal
NFE_TAX_REGIME=1

# Serie usada na emissao da NF-e
NFE_SERIES=1
